# Server configuration
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Database configuration (MongoDB must be running locally)
MONGO_URI=mongodb://localhost:27017/medico_hospital

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# Razorpay configuration (use Razorpay key id and key secret)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Legacy env names supported:
# RAZORPAY_KEY=your_razorpay_key_id_here
# RAZORPAY_SECRET=your_razorpay_key_secret_here

# Supabase Storage (file uploads) — requires service_role key (not anon)
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=lab-reports

# Email configuration (optional)
EMAIL_SERVICE=your_email_service_provider
EMAIL_USER=your_email_address@example.com
EMAIL_PASS=your_email_password_here
